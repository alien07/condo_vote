NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
APP_CANONICAL_URL=http://127.0.0.1:3000
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_LOCAL_AUTH_BYPASS=1
LOCAL_AUTH_BYPASS_EMAIL=demo.admin@example.test
LOCAL_AUTH_BYPASS_NAME="Demo Admin"
SKIP_DEV_PREFLIGHT=0

# Local Supabase defaults after `npm run supabase:start`:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<local publishable key from supabase status>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google oauth client id>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google oauth client secret>
# NEXT_PUBLIC_APP_URL=<generated by npm run demo:configure:local>
# APP_CANONICAL_URL=http://127.0.0.1:3000

# English drafts of meeting text (D020, demo feedback item 6b).
# "mock" answers from lib/translation/demo-translations.ts (default without a
# key). "azure" uses Azure AI Translator (free tier F0: 2M characters/month).
# Put the real key in .env.local only.
TRANSLATION_PROVIDER=mock
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=southeastasia
